# Copy to .env and fill in from Supabase dashboard -> Project Settings -> API Keys
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Connection string for the PRODUCTION database, so migrations can be pushed
# without an interactive password prompt:
#   npx supabase db push --db-url "$PROD_DB_URL" --include-all --yes
#
# Dashboard -> Project Settings -> Database -> Connection string -> URI, then
# replace [YOUR-PASSWORD] with the database password. Percent-encode any
# special characters in the password (@ becomes %40, # becomes %23).
#
# This is a full-privilege credential and .env is gitignored — keep it that
# way. Rotating the database password revokes it.
#
# Note: db.<ref>.supabase.co resolves to IPv6 only and will fail on a machine
# without an IPv6 route. Use the pooler host instead. The generation prefix
# (aws-0 / aws-1) and region both matter and differ per project — check with
# `npx supabase projects list`. GreatLibrary is aws-0-ca-central-1.
PROD_DB_URL=

# Personal access token from the dashboard -> account menu -> Access Tokens.
# Lets the Supabase Management API be called directly, e.g. to change auth
# redirect URLs without using the dashboard:
#   curl https://api.supabase.com/v1/projects/<ref>/config/auth \
#     -H "Authorization: Bearer $SUPABASE_ACCESS_TOKEN"
#
# Prefer this over `supabase config push`, which overwrites the WHOLE auth
# section from config.toml — including its local-dev site_url default, which
# would break sign-in on the live site.
SUPABASE_ACCESS_TOKEN=
